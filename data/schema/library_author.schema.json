{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_author.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "display_name",
    "summary",
    "canonical_path",
    "aliases",
    "trust_layer",
    "verification_status",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-author-[0-9a-f]{20}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "canonical_path": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trust_layer": {
      "enum": [
        "editorial",
        "verified_organisation",
        "community"
      ]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
