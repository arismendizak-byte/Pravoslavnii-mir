{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_text_asset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "work_ref",
    "edition_ref",
    "asset_kind",
    "language",
    "storage_mode",
    "content_path",
    "external_url",
    "rights_status",
    "license_url",
    "copyright_notice",
    "trust_layer",
    "verification_status",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-text-[0-9a-f]{20}$"
    },
    "work_ref": {
      "type": "string",
      "pattern": "^pm-work-[0-9a-f]{20}$"
    },
    "edition_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_kind": {
      "enum": [
        "full_text",
        "excerpt",
        "scripture_reference",
        "reference"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "storage_mode": {
      "enum": [
        "local_text",
        "external_url",
        "reference_only"
      ]
    },
    "content_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_status": {
      "enum": [
        "public_domain_verified",
        "open_license",
        "permission_granted",
        "metadata_only",
        "external_link_only",
        "restricted",
        "review_required"
      ]
    },
    "license_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "copyright_notice": {
      "type": [
        "string",
        "null"
      ]
    },
    "trust_layer": {
      "enum": [
        "editorial",
        "verified_organisation",
        "community"
      ]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_size_bytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage_mode": {
            "const": "local_text"
          }
        }
      },
      "then": {
        "required": [
          "content_sha256",
          "content_size_bytes"
        ],
        "properties": {
          "content_path": {
            "type": "string",
            "pattern": "^library/texts/[a-z0-9-]+\\.txt$"
          },
          "rights_status": {
            "enum": [
              "public_domain_verified",
              "open_license",
              "permission_granted"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "content_path": {
            "type": "null"
          }
        }
      }
    }
  ]
}
