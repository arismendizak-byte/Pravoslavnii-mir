{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news_source_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "const": "news"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "label",
          "source_file",
          "source_section",
          "mode",
          "trust_layer",
          "verification_status",
          "jurisdiction"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_section": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "review_only",
              "canonical_source"
            ]
          },
          "trust_layer": {
            "enum": [
              "legacy_unverified",
              "editorial",
              "verified_organisation",
              "community"
            ]
          },
          "verification_status": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "type": "string"
          },
          "origin_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
