{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_source_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "const": "library"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "label",
          "source_file",
          "source_section",
          "mode",
          "trust_layer",
          "verification_status",
          "jurisdiction",
          "rights_scope"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_section": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "system_policy",
              "canonical_source",
              "review_only"
            ]
          },
          "trust_layer": {
            "enum": [
              "canonical_system",
              "editorial",
              "verified_organisation",
              "community",
              "legacy_unverified"
            ]
          },
          "verification_status": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "type": "string"
          },
          "rights_scope": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
