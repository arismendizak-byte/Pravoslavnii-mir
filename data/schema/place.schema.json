{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravoslavnii-mir.local/schema/place.schema.json",
  "title": "Православный Мир — Place",
  "description": "Каноническая модель места для карты, каталога, поиска и карточек объектов.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "name",
    "place_type",
    "status",
    "address",
    "location",
    "source_records",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^pm-[0-9a-f]{32}$",
      "description": "Неизменяемый внутренний ID. На импорте создаётся детерминированно."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "alt_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true,
      "default": []
    },
    "place_type": {
      "type": "string",
      "enum": [
        "church",
        "cathedral",
        "chapel",
        "monastery",
        "skete",
        "metochion",
        "bell_tower",
        "holy_spring",
        "memorial",
        "other",
        "unknown"
      ]
    },
    "type_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "preserved",
        "inactive",
        "ruined",
        "lost",
        "under_construction",
        "restoring",
        "unknown"
      ]
    },
    "status_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "from_year",
        "to_year"
      ],
      "properties": {
        "raw_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "from_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2200
        },
        "to_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2200
        }
      }
    },
    "architects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true,
      "default": []
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "country",
        "region",
        "district",
        "locality",
        "formatted"
      ],
      "properties": {
        "country_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "district": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "locality": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "formatted": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon",
        "precision"
      ],
      "properties": {
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "locality",
            "unknown"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "lat": {
              "type": "null"
            },
            "lon": {
              "type": "null"
            }
          }
        }
      ]
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "full": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dedications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true,
      "default": []
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url",
          "path",
          "caption",
          "source_url",
          "license"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "icon",
              "other"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "caption": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "license": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        },
        "oneOf": [
          {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              }
            }
          }
        ]
      },
      "default": []
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detail_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "official_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "map_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "source_id",
          "source_url",
          "imported_at",
          "last_verified_at"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "raw_type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "raw_status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_file": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "source_row": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_region": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "merged_from_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^pm-[0-9a-f]{32}$"
      },
      "uniqueItems": true,
      "default": [],
      "description": "IDs записей, автоматически объединённых в этот канонический объект."
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "flags"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
