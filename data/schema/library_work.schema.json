{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_work.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "work_type",
    "summary",
    "original_language",
    "canonical_path",
    "rights_status",
    "aliases",
    "trust_layer",
    "verification_status",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-work-[0-9a-f]{20}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "work_type": {
      "enum": [
        "scripture",
        "life",
        "theology",
        "prayer",
        "sermon",
        "church_history",
        "patristic",
        "liturgy",
        "hymnography",
        "catechesis",
        "other"
      ]
    },
    "summary": {
      "type": "string"
    },
    "original_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_path": {
      "type": "string",
      "minLength": 1
    },
    "rights_status": {
      "enum": [
        "public_domain_verified",
        "open_license",
        "permission_granted",
        "metadata_only",
        "external_link_only",
        "restricted",
        "review_required"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "trust_layer": {
      "enum": [
        "editorial",
        "verified_organisation",
        "community"
      ]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
