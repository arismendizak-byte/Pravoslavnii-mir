{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/event_source_bundle.schema.json",
  "title": "Pravmir event source bundle",
  "type": "object",
  "required": ["schema_version", "provider", "trust_layer", "events"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "trust_layer": {"enum": ["editorial", "verified_organisation", "community"]},
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_event"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_event": {
      "type": "object",
      "required": ["source_id", "title", "event_type", "temporal", "status", "freshness", "references"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": ["string", "null"]},
        "event_type": {"enum": ["service", "procession", "lecture", "pilgrimage_trip", "parish_event", "pilgrim_event", "meeting", "other"]},
        "temporal": {"$ref": "#/$defs/temporal"},
        "status": {"enum": ["scheduled", "cancelled", "postponed", "completed", "draft"]},
        "venue": {"$ref": "#/$defs/venue"},
        "organizer": {"$ref": "#/$defs/organizer"},
        "registration": {"$ref": "#/$defs/registration"},
        "scope": {"$ref": "#/$defs/scope"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "references": {"$ref": "content_item.schema.json#/$defs/references"},
        "source_url": {"type": ["string", "null"]},
        "evidence_note": {"type": ["string", "null"]},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "required": ["all_day", "starts_at", "ends_at", "timezone", "recurrence"],
      "properties": {
        "all_day": {"type": "boolean"},
        "starts_at": {"type": "string", "minLength": 10},
        "ends_at": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]},
        "recurrence": {
          "type": "object",
          "required": ["kind", "rrule"],
          "properties": {
            "kind": {"enum": ["none", "rrule"]},
            "rrule": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "venue": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "address": {"type": ["string", "null"]},
        "place_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "organizer": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "organisation_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "registration": {
      "type": ["object", "null"],
      "properties": {
        "required": {"type": ["boolean", "null"]},
        "url": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": ["object", "null"],
      "properties": {
        "jurisdiction": {"type": ["string", "null"]},
        "tradition": {"type": ["string", "null"]},
        "locale": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["observed_at", "verified_at", "expires_at"],
      "properties": {
        "observed_at": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"]},
        "expires_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
