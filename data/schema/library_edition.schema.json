{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_edition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "work_ref",
    "title",
    "language",
    "publisher",
    "publication_year",
    "identifiers",
    "rights_status",
    "trust_layer",
    "verification_status",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-edition-[0-9a-f]{20}$"
    },
    "work_ref": {
      "type": "string",
      "pattern": "^pm-work-[0-9a-f]{20}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "publisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 3000
    },
    "identifiers": {
      "type": "object"
    },
    "rights_status": {
      "enum": [
        "public_domain_verified",
        "open_license",
        "permission_granted",
        "metadata_only",
        "external_link_only",
        "restricted",
        "review_required"
      ]
    },
    "trust_layer": {
      "enum": [
        "editorial",
        "verified_organisation",
        "community"
      ]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
