{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/content_category.schema.json",
  "title": "Pravmir content category",
  "type": "object",
  "required": ["id", "name", "slug", "verification_status", "source_records"],
  "properties": {
    "id": {"type": "string", "pattern": "^pm-category-[0-9a-f]{20}$"},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "verification_status": {"enum": ["legacy_curated", "source_verified", "editorial_verified"]},
    "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "content_item.schema.json#/$defs/source_record"}}
  },
  "additionalProperties": false
}
