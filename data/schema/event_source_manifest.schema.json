{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/event_source_manifest.schema.json",
  "title": "Pravmir event source manifest",
  "type": "object",
  "required": ["schema_version", "domain", "trust_layers", "providers"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "domain": {"const": "events"},
    "trust_layers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "canonical_eligible", "description"],
        "properties": {
          "id": {"enum": ["editorial", "verified_organisation", "community"]},
          "canonical_eligible": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "source_file", "trust_layer", "verification_status", "authority_class", "jurisdiction", "tradition", "locale"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "source_file": {"type": "string", "minLength": 1},
          "trust_layer": {"enum": ["editorial", "verified_organisation", "community"]},
          "verification_status": {"enum": ["editorial_verified", "verified_organisation", "community_unverified"]},
          "authority_class": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": ["string", "null"]},
          "tradition": {"type": ["string", "null"]},
          "locale": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
