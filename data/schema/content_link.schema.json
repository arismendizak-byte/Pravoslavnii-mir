{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/content_link.schema.json",
  "title": "Pravmir content graph link",
  "type": "object",
  "required": [
    "id",
    "relation_type",
    "from",
    "to",
    "verification_status",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-clink-[0-9a-f]{20}$"
    },
    "relation_type": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "$ref": "#/$defs/ref"
    },
    "to": {
      "$ref": "#/$defs/ref"
    },
    "verification_status": {
      "enum": [
        "source_verified",
        "editorial_verified"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "content_item.schema.json#/$defs/source_record"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "place",
            "entity",
            "route",
            "content",
            "event",
            "calendar_entry",
            "pilgrim_service",
            "author",
            "saint",
            "icon",
            "feast",
            "work",
            "organisation",
            "calendar_day",
            "commemoration",
            "fasting_rule",
            "reading"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
