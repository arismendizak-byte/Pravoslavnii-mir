{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/calendar_entry.schema.json",
  "title": "Pravmir calendar entry",
  "type": "object",
  "required": ["id", "calendar_kind", "title", "date_start", "date_end", "calendar_system", "verification_status", "references", "source_records"],
  "properties": {
    "id": {"type": "string", "pattern": "^pm-cal-[0-9a-f]{20}$"},
    "calendar_kind": {"enum": ["feast", "commemoration", "fast", "calendar_event"]},
    "title": {"type": "string", "minLength": 1},
    "date_start": {"type": "string", "format": "date"},
    "date_end": {"type": "string", "format": "date"},
    "calendar_system": {"enum": ["civil_date_legacy", "julian_derived", "gregorian"]},
    "verification_status": {"enum": ["legacy_unverified", "source_verified", "editorial_verified"]},
    "references": {"type": "array", "items": {"$ref": "content_item.schema.json#/$defs/reference"}},
    "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "content_item.schema.json#/$defs/source_record"}}
  },
  "additionalProperties": false
}
