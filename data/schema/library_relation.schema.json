{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_relation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "relation_type",
    "from",
    "to",
    "trust_layer",
    "verification_status",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-library-rel-[0-9a-f]{20}$"
    },
    "relation_type": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "work",
            "author",
            "edition",
            "text_asset",
            "media_asset",
            "reading"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "work",
            "author",
            "saint",
            "place",
            "feast",
            "content",
            "news",
            "route",
            "event",
            "organisation"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust_layer": {
      "enum": [
        "editorial",
        "verified_organisation",
        "community"
      ]
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
