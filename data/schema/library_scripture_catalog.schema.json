{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library_scripture_catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "verified_on",
    "provider",
    "source_url",
    "translation_label",
    "rights_status",
    "notes",
    "authors",
    "works"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "const": "library_scripture_catalog"
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "translation_label": {
      "type": "string",
      "minLength": 1
    },
    "rights_status": {
      "const": "metadata_only"
    },
    "notes": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "display_name",
          "aliases"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_prefix",
          "key",
          "title",
          "author_key",
          "author_relation_type"
        ],
        "properties": {
          "citation_prefix": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "author_relation_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
