{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/food_source_bundle.schema.json",
  "title": "Pravmir food source bundle",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_recipe"
      }
    }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "required": [
        "name",
        "amount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "dietary": {
      "type": "object",
      "required": [
        "contains_meat",
        "contains_dairy",
        "contains_eggs",
        "contains_fish",
        "contains_alcohol",
        "uses_oil",
        "plant_based"
      ],
      "properties": {
        "contains_meat": {
          "type": "boolean"
        },
        "contains_dairy": {
          "type": "boolean"
        },
        "contains_eggs": {
          "type": "boolean"
        },
        "contains_fish": {
          "type": "boolean"
        },
        "contains_alcohol": {
          "type": "boolean"
        },
        "uses_oil": {
          "type": "boolean"
        },
        "plant_based": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fasting": {
      "type": "object",
      "required": [
        "classification",
        "oil_mode",
        "note"
      ],
      "properties": {
        "classification": {
          "enum": [
            "general_fast_friendly",
            "not_classified"
          ]
        },
        "oil_mode": {
          "enum": [
            "none",
            "optional",
            "used"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source_recipe": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "summary",
        "recipe_type",
        "servings",
        "prep_minutes",
        "cook_minutes",
        "ingredients",
        "steps",
        "tags",
        "dietary_profile",
        "fasting_compatibility"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "recipe_type": {
          "enum": [
            "soup",
            "main",
            "salad",
            "breakfast",
            "dessert",
            "baking",
            "drink",
            "other"
          ]
        },
        "servings": {
          "type": "integer",
          "minimum": 1
        },
        "prep_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "cook_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dietary_profile": {
          "$ref": "#/$defs/dietary"
        },
        "fasting_compatibility": {
          "$ref": "#/$defs/fasting"
        },
        "feast_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pm-feast-[0-9a-f]{20}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
