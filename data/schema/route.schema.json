{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/route.schema.json",
  "title": "Pravmir canonical route",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "stops",
    "waypoints",
    "source_records",
    "verification_status",
    "quality_flags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-route-[a-f0-9]{24}$"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration": {
      "type": [
        "string",
        "null"
      ]
    },
    "distance": {
      "type": [
        "string",
        "null"
      ]
    },
    "price": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "badge": {
      "type": [
        "string",
        "null"
      ]
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "enum": [
        "legacy_unverified",
        "source_verified"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "place_id",
          "quality_flags"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "place_id": {
            "type": "string",
            "pattern": "^pm-[a-f0-9]{32}$"
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order",
          "label",
          "place_id",
          "detail_path",
          "quality_flags"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "place_id": {
            "type": "null"
          },
          "detail_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
