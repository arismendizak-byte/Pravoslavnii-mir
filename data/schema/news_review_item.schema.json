{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news_review_item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "published_on",
    "source_url",
    "publisher_text",
    "trust_layer",
    "verification_status",
    "review_status",
    "legacy_content_ref",
    "source_records"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pm-news-review-[0-9a-f]{20}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "published_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "publisher_text": {
      "type": "string"
    },
    "trust_layer": {
      "const": "legacy_unverified"
    },
    "verification_status": {
      "const": "legacy_unverified"
    },
    "review_status": {
      "enum": [
        "needs_source_verification",
        "promoted",
        "rejected"
      ]
    },
    "legacy_content_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
