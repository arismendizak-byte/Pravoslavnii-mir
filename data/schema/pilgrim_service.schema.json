{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pravmir.local/schema/pilgrim_service.schema.json",
  "title": "Pravmir pilgrim service",
  "type": "object",
  "required": ["id", "service_type", "name", "region_text", "organization", "contacts", "verification_status", "references", "source_records"],
  "properties": {
    "id": {"type": "string", "pattern": "^pm-pilgrim-[0-9a-f]{20}$"},
    "service_type": {"enum": ["pilgrimage_service", "lodging", "refectory", "shop", "parking", "family_service", "other"]},
    "name": {"type": "string", "minLength": 1},
    "region_text": {"type": ["string", "null"]},
    "organization": {"type": ["string", "null"]},
    "contacts": {
      "type": "object",
      "required": ["phone", "website", "email"],
      "properties": {
        "phone": {"type": ["string", "null"]},
        "website": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "verification_status": {"enum": ["legacy_unverified", "source_verified", "editorial_verified"]},
    "references": {"type": "array", "items": {"$ref": "content_item.schema.json#/$defs/reference"}},
    "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "content_item.schema.json#/$defs/source_record"}}
  },
  "additionalProperties": false
}
